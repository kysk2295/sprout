# 정적 파일 서버 — Railway가 넣어 주는 $PORT에서 듣는다(TLS는 Railway가 앞단에서 처리)
{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	respond /healthz 200 {
		body "ok"
	}

	# 스토어에 적힌 옛 주소 → 새 주소
	redir /delete-account /account-deletion 301
	redir /privacy-policy /privacy 301
	redir /index.html / 301

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	@html path / *.html /privacy /terms /account-deletion /support
	header @html Cache-Control "public, max-age=300"
	@static path /assets/* /*.png /*.svg /*.ico
	header @static Cache-Control "public, max-age=604800"

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors {
		@404 expression {err.status_code} == 404
		rewrite @404 /404.html
		file_server
	}
}
