{
  "name": "sprout",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "server/api"
  ],
  "scripts": {
    "dev": "npm run dev -w @sprout/desktop",
    "web": "npm run web -w @sprout/desktop",
    "build": "npm run build -w @sprout/desktop",
    "typecheck": "npm run typecheck -w @sprout/desktop",
    "test": "npm test -w @sprout/schema",
    "test:desktop": "node scripts/test-desktop-data.mjs",
    "server:schema": "node --experimental-strip-types --no-warnings server/scripts/gen-sql.ts",
    "test:api": "npm test -w @sprout/api",
    "dist:mac": "npm run dist:mac -w @sprout/desktop",
    "dist:mac:release": "npm run dist:mac:release -w @sprout/desktop",
    "widget:build": "npm run widget:build -w @sprout/desktop",
    "mobile": "npm run start -w @sprout/mobile",
    "mobile:ios": "npm run ios -w @sprout/mobile",
    "mobile:android": "npm run android -w @sprout/mobile",
    "typecheck:mobile": "npm run typecheck -w @sprout/mobile",
    "test:mobile": "npm test -w @sprout/mobile"
  }
}
