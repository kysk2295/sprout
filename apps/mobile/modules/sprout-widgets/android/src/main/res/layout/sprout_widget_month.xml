<?xml version="1.0" encoding="utf-8"?>
<!-- 36 §3.1 월 캘린더: 머리(‹ 달 › · +) · 요일 줄 · 주 줄(코드가 addView) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:background="@drawable/sprout_widget_bg"
  android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="8dp" android:paddingBottom="4dp">
  <RelativeLayout android:layout_width="match_parent" android:layout_height="28dp">
    <LinearLayout android:id="@+id/sw_nav" android:layout_width="wrap_content" android:layout_height="match_parent"
      android:layout_centerHorizontal="true" android:orientation="horizontal" android:gravity="center_vertical">
      <ImageView android:id="@+id/sw_prev" android:layout_width="32dp" android:layout_height="28dp" android:padding="6dp"
        android:src="@drawable/sprout_widget_chevron_left" android:contentDescription="지난달" />
      <TextView android:id="@+id/sw_title" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center" android:paddingLeft="6dp" android:paddingRight="6dp"
        android:textSize="16sp" android:textStyle="bold" android:textColor="@color/sprout_widget_accent" />
      <ImageView android:id="@+id/sw_next" android:layout_width="32dp" android:layout_height="28dp" android:padding="6dp"
        android:src="@drawable/sprout_widget_chevron_right" android:contentDescription="다음 달" />
    </LinearLayout>
    <FrameLayout android:id="@+id/sw_add" android:layout_width="26dp" android:layout_height="26dp"
      android:layout_alignParentRight="true" android:layout_centerVertical="true" android:contentDescription="할 일 추가">
      <ImageView android:id="@+id/sw_add_bg" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/sprout_widget_circle" />
      <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:padding="6dp" android:src="@drawable/sprout_widget_plus" />
    </FrameLayout>
  </RelativeLayout>
  <LinearLayout android:id="@+id/sw_weekhead" android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" />
  <LinearLayout android:id="@+id/sw_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
  <TextView android:id="@+id/sw_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:gravity="center" android:textSize="13sp" android:textColor="@color/sprout_widget_secondary" android:visibility="gone" />
</LinearLayout>
