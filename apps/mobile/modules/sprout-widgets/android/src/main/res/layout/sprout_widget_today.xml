<?xml version="1.0" encoding="utf-8"?>
<!-- 36 §3.2 오늘 할 일: 머리 "오늘 N" + 행(코드가 addView) + 넘침 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="vertical" android:background="@drawable/sprout_widget_bg"
  android:paddingLeft="14dp" android:paddingRight="12dp" android:paddingTop="10dp" android:paddingBottom="8dp">
  <LinearLayout android:id="@+id/sw_head" android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
    <TextView android:id="@+id/sw_head_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘"
      android:textSize="16sp" android:textStyle="bold" android:textColor="@color/sprout_widget_accent" />
    <TextView android:id="@+id/sw_head_count" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:paddingLeft="6dp"
      android:textSize="16sp" android:textColor="@color/sprout_widget_accent" />
    <ImageView android:id="@+id/sw_head_plus" android:layout_width="28dp" android:layout_height="28dp" android:padding="5dp"
      android:src="@drawable/sprout_widget_plus" android:contentDescription="할 일 추가" />
  </LinearLayout>
  <LinearLayout android:id="@+id/sw_rows" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" />
  <TextView android:id="@+id/sw_message" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
    android:gravity="center" android:textSize="13sp" android:textColor="@color/sprout_widget_secondary" android:visibility="gone" />
  <TextView android:id="@+id/sw_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
    android:textSize="11sp" android:textColor="@color/sprout_widget_tertiary" android:visibility="gone" />
</LinearLayout>
