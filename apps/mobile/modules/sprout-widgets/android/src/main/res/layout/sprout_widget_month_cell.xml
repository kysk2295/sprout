<?xml version="1.0" encoding="utf-8"?>
<!-- 칸: 날짜 숫자(오늘 = 강조색 원) + 공휴일 이름 · 막대(코드가 addView) · +N -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/sw_cell"
  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
  android:orientation="vertical" android:paddingLeft="1dp" android:paddingRight="1dp" android:paddingTop="2dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="17dp" android:orientation="horizontal" android:gravity="center_vertical">
    <FrameLayout android:layout_width="17dp" android:layout_height="17dp">
      <ImageView android:id="@+id/sw_today" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/sprout_widget_circle" android:visibility="gone" />
      <TextView android:id="@+id/sw_num" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
        android:textSize="11sp" android:textColor="@color/sprout_widget_primary" android:includeFontPadding="false" />
    </FrameLayout>
    <TextView android:id="@+id/sw_holiday" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingLeft="1dp"
      android:textSize="7.5sp" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:visibility="gone" />
  </LinearLayout>
  <LinearLayout android:id="@+id/sw_bars" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
  <TextView android:id="@+id/sw_more" android:layout_width="match_parent" android:layout_height="12dp" android:paddingLeft="3dp"
    android:textSize="9sp" android:textColor="@color/sprout_widget_tertiary" android:includeFontPadding="false" android:visibility="gone" />
</LinearLayout>
