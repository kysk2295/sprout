{
  "name": "@sprout/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "sprout 모바일 — React Native(Expo 개발용 빌드). docs/screens/20~24",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "tokens": "node scripts/gen-tokens.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --no-warnings src/theme/theme.test.ts && node --experimental-strip-types --no-warnings src/data/views.test.ts"
  },
  "dependencies": {
    "@azure/core-asynciterator-polyfill": "^1.0.2",
    "@op-engineering/op-sqlite": "18.2.5",
    "@powersync/react-native": "2.3.1",
    "@sprout/schema": "*",
    "expo": "~57.0.26",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-async-generator-functions": "^7.25.0",
    "@sprout/tokens": "*",
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  }
}
