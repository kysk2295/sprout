<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  sprout 메인 앱 entitlements (Developer ID 배포 + 하드닝 런타임용). 앱 샌드박스는 쓰지 않는다(Developer ID는 필수 아님).
  - allow-jit: Electron(V8)이 JIT를 쓰므로 하드닝 런타임에서 필수.
  - disable-library-validation은 넣지 않았다: 네이티브 모듈(better-sqlite3 .node, PowerSync 확장 .dylib)은
    electron-builder가 같은 팀 ID로 다시 서명하므로 라이브러리 검증을 통과한다. 공증 빌드에서 로드 실패가 나면 그때 추가한다.
  자세한 설명: docs/release/packaging.md
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <!-- 16 §11.4 Apple 캘린더 읽기(하드닝 런타임에서 EventKit 접근) -->
  <key>com.apple.security.personal-information.calendars</key>
  <true/>

  <!--
    macOS 위젯(WidgetKit, docs/screens/25-mac-widget.md §8.2)과 데이터를 나누는 App Group.
    이름 = 팀 ID + 번들 ID. 팀 ID는 서명 인증서의 OU(지금 개발 인증서 BU697KN34B — 인증서 이름 괄호 안 값 Z32F3Z65RD는 팀 ID가 아니다).
    팀 ID 접두 형식이라 프로비저닝 프로파일 없이 쓴다. 같은 값: src/main/widget.ts, native/widget/SproutWidget/SproutWidget.entitlements.
    Developer ID로 바꿀 때 팀 ID가 다르면 네 곳을 같이 바꾼다(packaging.md §4).
  -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>BU697KN34B.app.sprout.desktop</string>
  </array>
</dict>
</plist>
