{
  "name": "@sprout/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "sprout — 할 일·캘린더 + 성장 루프",
  "author": "sprout",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "web": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist:mac": "electron-vite build && node build/dist-mac-local.mjs",
